# "/" for Vercel / user sites, "/repository-name/" for GitHub Pages project sites
VITE_BASE_PATH=/
# Reserved for a keyed routing provider (not used by the default provider).
# Anything VITE_* is bundled into public JS - never put a private secret here.
VITE_ROUTE_API_KEY=
VITE_GITHUB_URL=https://github.com
# Leave empty on Vercel. For GitHub Pages, point this to your Vercel deployment origin.
VITE_API_BASE_URL=
